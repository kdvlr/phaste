# Database (PostgreSQL with pgvector)
# On linsrv, postgres is accessible on the Docker network as postgres:5432
DATABASE_URL=postgresql+asyncpg://phaste:phaste_password@postgres:5432/phaste

# Security & API Token
# Generate a secure random token: openssl rand -hex 24
PHASTE_API_TOKEN=phaste_secret_token_change_me

# Media Storage
MEDIA_ROOT=/data/media

# Ingestion Constraints (ADR 0004)
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_HEIGHT=1080
SCRAPE_TIMEOUT_SECONDS=1.5

# Vision Embeddings
EMBEDDING_MODEL=openai/clip-vit-base-patch32
MODELS_CACHE_DIR=/data/models

# Server Configuration
PORT=8000
HOST=0.0.0.0
TRUST_PROXY_HEADERS=true
